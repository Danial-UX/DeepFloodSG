@startuml View-Data-Sequence-Diagram
actor User
box "Frontend" #LightGreen
participant "API Client Module" as Frontend
participant "Data Visualisation Module" as DataVisualisation
end box
box "Backend" #LightBlue
participant "API Server Module" as Backend
participant "Data Analytics Module" as AnalyticsModule
participant "Data Retrieval Processor" as RetrievalProcessor
end box
box "Database" #LightYellow
database "PostgreSQL Database" as Database
end box

User -> Frontend: Navigate to Data Exploration Page
activate Frontend
Frontend -> Backend: Request data for exploration
deactivate Frontend
activate Backend
Backend -> RetrievalProcessor: Forward request
activate RetrievalProcessor
RetrievalProcessor -> Database: Query data
activate Database

alt Data Available
    Database --> RetrievalProcessor: Return raw data
    deactivate Database
    RetrievalProcessor --> AnalyticsModule: Send raw data for analysis
    deactivate RetrievalProcessor
    activate AnalyticsModule
    AnalyticsModule --> Backend: Return processed data
    deactivate AnalyticsModule
    Backend --> DataVisualisation: Return processed data
    activate DataVisualisation
    deactivate Backend
    DataVisualisation --> User: Display data
    deactivate DataVisualisation
else No Data Available
    Database --> RetrievalProcessor: No data found
    RetrievalProcessor --> Backend: Return "No data available" response
    deactivate RetrievalProcessor
    Backend --> DataVisualisation: Return empty dataset
    deactivate Backend
    DataVisualisation --> User: Show empty data visualisation
end alt

@enduml
